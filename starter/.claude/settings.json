{
  "permissions": {
    "deny": [
      "Bash(make unlock)"
    ],
    "allow": [
      "Bash(make check *)",
      "Bash(make practice *)",
      "Bash(make eval *)",
      "Bash(make test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-evals.sh"
          }
        ]
      }
    ]
  }
}
