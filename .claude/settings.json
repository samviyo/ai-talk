{
  "permissions": {
    "deny": [
      "Bash(make golden*)",
      "Bash(make unlock-alibi*)"
    ],
    "allow": [
      "Bash(make parity*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-team-evals.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-alibi-evals.sh"
          }
        ]
      }
    ]
  }
}
